---
import Layout from "../../layouts/Layout.astro";
import AppShell from "../../components/AppShell.astro";
import { learningItems } from "../../data/learning";
---

<Layout title="Games - YokisLearn">
  <AppShell active="Games">
    <section class="border-b border-slate-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <p class="text-sm font-black uppercase tracking-normal text-red-700">Games</p>
        <h1 class="mt-2 text-3xl font-black text-slate-950 sm:text-4xl">Latihan cepat</h1>
        <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-600">Mode awal untuk menjawab arti item secara acak. Score masih lokal dan nanti bisa dikirim ke Supabase.</p>
      </div>
    </section>

    <section class="mx-auto grid max-w-7xl gap-6 px-4 py-8 sm:px-6 lg:grid-cols-[1fr_320px] lg:px-8">
      <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between gap-4">
          <div>
            <div id="gameMeta" class="text-sm font-black uppercase tracking-normal text-slate-500">Ready</div>
            <div id="gamePrompt" class="mt-4 font-serif text-7xl font-bold leading-none text-slate-950">始</div>
          </div>
          <div class="rounded-lg bg-slate-950 px-4 py-3 text-center text-white">
            <div id="score" class="text-3xl font-black">0</div>
            <div class="text-xs font-bold uppercase tracking-normal text-slate-300">score</div>
          </div>
        </div>
        <div id="options" class="mt-8 grid gap-3 sm:grid-cols-2"></div>
        <button id="next" class="mt-5 hidden rounded-lg bg-red-700 px-5 py-3 text-sm font-black text-white">Soal berikut</button>
      </div>

      <aside class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-black text-slate-950">Roadmap games</h2>
        <div class="mt-4 space-y-3 text-sm leading-6 text-slate-600">
          <p><strong class="text-slate-950">Speed quiz:</strong> jawab sebanyak mungkin dalam batas waktu.</p>
          <p><strong class="text-slate-950">Matching:</strong> cocokkan kanji/kotoba dengan arti.</p>
          <p><strong class="text-slate-950">Boss review:</strong> ulangi item yang sering salah.</p>
          <p><strong class="text-slate-950">Leaderboard:</strong> score per user via Supabase.</p>
        </div>
      </aside>
    </section>

    <script define:vars={{ learningItems }}>
      const playable = learningItems.filter((item) => item.status !== "draft");
      const promptEl = document.getElementById("gamePrompt");
      const metaEl = document.getElementById("gameMeta");
      const optionsEl = document.getElementById("options");
      const scoreEl = document.getElementById("score");
      const nextBtn = document.getElementById("next");
      let current;
      let score = Number(localStorage.getItem("yokislearn-game-score") || 0);
      scoreEl.textContent = score;

      function shuffle(items) {
        return items.map((item) => ({ item, sort: Math.random() })).sort((a, b) => a.sort - b.sort).map(({ item }) => item);
      }

      function renderRound() {
        current = shuffle(playable)[0];
        const options = shuffle([current, ...shuffle(playable.filter((item) => item.id !== current.id)).slice(0, 3)]);
        promptEl.textContent = current.prompt;
        metaEl.textContent = current.type === "kanji" ? `Kanji ${current.level.toUpperCase()}` : `${current.level.toUpperCase()} ${current.type} Bab ${current.chapter}`;
        nextBtn.classList.add("hidden");
        optionsEl.innerHTML = options.map((item) => `<button class="option rounded-lg border border-slate-300 px-4 py-4 text-left text-sm font-black text-slate-800 transition hover:border-slate-950" data-id="${item.id}">${item.meaning}</button>`).join("");
      }

      optionsEl.addEventListener("click", (event) => {
        const button = event.target.closest("button");
        if (!button || button.disabled) return;
        const correct = button.dataset.id === current.id;
        [...optionsEl.querySelectorAll("button")].forEach((item) => {
          item.disabled = true;
          if (item.dataset.id === current.id) item.classList.add("border-emerald-600", "bg-emerald-50", "text-emerald-800");
        });
        if (!correct) button.classList.add("border-red-700", "bg-red-50", "text-red-800");
        if (correct) {
          score += 10;
          localStorage.setItem("yokislearn-game-score", String(score));
          scoreEl.textContent = score;
        }
        nextBtn.classList.remove("hidden");
      });

      nextBtn.addEventListener("click", renderRound);
      renderRound();
    </script>
  </AppShell>
</Layout>
