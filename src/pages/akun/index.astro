---
import Layout from "../../layouts/Layout.astro";
import AppShell from "../../components/AppShell.astro";
import { plannedTables } from "../../lib/supabase";
---

<Layout title="Akun dan Supabase - YokisLearn">
  <AppShell active="Akun">
    <section class="border-b border-slate-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <p class="text-sm font-black uppercase tracking-normal text-red-700">Supabase ready</p>
        <h1 class="mt-2 text-3xl font-black text-slate-950 sm:text-4xl">Akun, nilai, dan progres</h1>
        <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-600">
          Halaman ini menjadi tempat login, profil user, riwayat latihan, score games, dan progres hafalan setelah kredensial Supabase ditambahkan.
        </p>
      </div>
    </section>

    <section class="mx-auto grid max-w-7xl gap-6 px-4 py-8 sm:px-6 lg:grid-cols-2 lg:px-8">
      <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-black text-slate-950">Environment</h2>
        <p class="mt-3 text-sm leading-7 text-slate-600">Tambahkan variabel ini di `.env` saat project Supabase sudah dibuat.</p>
        <pre class="mt-4 overflow-x-auto rounded-lg bg-slate-950 p-4 text-sm leading-6 text-slate-100"><code>PUBLIC_SUPABASE_URL=...
PUBLIC_SUPABASE_ANON_KEY=...</code></pre>
      </div>

      <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-black text-slate-950">Tabel yang disiapkan</h2>
        <div class="mt-4 grid gap-2">
          {plannedTables.map((table) => (
            <div class="rounded-lg bg-slate-100 px-3 py-2 text-sm font-black text-slate-800">{table}</div>
          ))}
        </div>
      </div>
    </section>
  </AppShell>
</Layout>
