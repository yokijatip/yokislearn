---
import Layout from "../../../layouts/Layout.astro";
import AppShell from "../../../components/AppShell.astro";
import { getChapters, getItems, levels, materialTypes, type Level, type MaterialType } from "../../../data/learning";

export function getStaticPaths() {
  return materialTypes.flatMap((type) =>
    levels.map((level) => ({
      params: { type: type.id, level: level.id },
    })),
  );
}

const { type, level } = Astro.params as { type: MaterialType; level: Level };
const material = materialTypes.find((item) => item.id === type)!;
const levelInfo = levels.find((item) => item.id === level)!;
const items = getItems(type, level);
const chapters = getChapters(type, level);
const activeName = material.label;
---

<Layout title={`${material.label} ${levelInfo.label} - YokisLearn`}>
  <AppShell active={activeName}>
    <section class="mx-auto w-full max-w-4xl overflow-x-clip px-3 py-5 sm:px-4 sm:py-8">
      <div class="min-w-0 space-y-4">
          <div class="rounded-[1.5rem] border border-stone-200/80 bg-white/95 p-4 shadow-lg shadow-slate-900/5">
            <div class="flex items-center justify-between gap-3">
              <div class="min-w-0">
                <div class="text-xs font-black uppercase tracking-wider text-red-600">{levelInfo.label}</div>
                <h1 class="mt-1 truncate text-2xl font-black text-slate-950">{material.label}</h1>
              </div>
              <div class="shrink-0 rounded-2xl bg-slate-950 px-3 py-2 text-sm font-black text-white">{items.length} item</div>
            </div>

            <div class="mt-4 grid grid-cols-2 gap-2">
              {levels.map((target) => (
                <a href={`/belajar/${type}/${target.id}`} class:list={[
                  "rounded-xl px-3 py-2.5 text-center text-sm font-black transition active:scale-95",
                  target.id === level ? "bg-slate-950 text-white shadow-sm" : "border border-black/5 bg-stone-100 text-slate-700 hover:bg-stone-200/80",
                ]}>
                  {target.label}
                </a>
              ))}
            </div>

            <div class="mt-2 grid grid-cols-2 gap-2">
              {materialTypes.map((target) => (
                <a href={`/belajar/${target.id}/${level}`} class:list={[
                  "rounded-xl px-3 py-2.5 text-center text-sm font-black transition active:scale-95",
                  target.id === type ? "bg-[#a64332] text-white shadow-sm" : "border border-black/5 bg-stone-100 text-slate-700 hover:bg-stone-200/80",
                ]}>
                  {target.label}
                </a>
              ))}
            </div>
          </div>
          
          <!-- Tab-style Horizontal Bab/Grup Selector -->
          <div class="flex items-center gap-2 overflow-x-auto scrollbar-none pb-2" id="chapterTabs">
            <button class="chapter-tab shrink-0 rounded-full px-5 py-2.5 text-sm font-black transition-all bg-slate-950 text-white shadow-sm cursor-pointer" data-chapter="all">Semua</button>
            {chapters.map((chapter) => (
              <button class="chapter-tab shrink-0 rounded-full px-5 py-2.5 text-sm font-black transition-all bg-white text-slate-700 hover:bg-slate-100 border border-black/5 cursor-pointer" data-chapter={chapter}>
                {type === "kanji" ? "Grup" : "Bab"} {chapter}
              </button>
            ))}
          </div>

          <!-- Mode Switcher Tabs (Kartu, Belum Hafal, Kuis, Daftar) -->
          <div class="grid grid-cols-4 gap-1 rounded-2xl bg-[#ede8e0]/60 p-1 border border-stone-200/30">
            <button class="mode-btn flex items-center justify-center gap-2 rounded-xl py-2.5 text-sm font-black transition-all bg-white text-slate-950 shadow-sm cursor-pointer flex-1" data-mode="flashcard">
              <svg class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <rect x="3" y="4" width="18" height="16" rx="3" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 8h10M7 12h10M7 16h6" />
              </svg>
              <span>Kartu</span>
            </button>
            <button class="mode-btn flex items-center justify-center gap-2 rounded-xl py-2.5 text-sm font-black transition-all text-stone-700 hover:bg-white/50 cursor-pointer flex-1" data-mode="unmemorized">
              <svg class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 11l3 3L22 4" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11" />
              </svg>
              <span>Belum</span>
            </button>
            <button class="mode-btn flex items-center justify-center gap-2 rounded-xl py-2.5 text-sm font-black transition-all text-stone-700 hover:bg-white/50 cursor-pointer flex-1" data-mode="quiz">
              <svg class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12c0 1.821.487 3.53 1.338 5L2.5 21.5l4.5-.838A9.953 9.953 0 0012 22z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 17h.01" />
              </svg>
              <span>Kuis</span>
            </button>
            <button class="mode-btn flex items-center justify-center gap-2 rounded-xl py-2.5 text-sm font-black transition-all text-stone-700 hover:bg-white/50 cursor-pointer flex-1" data-mode="list">
              <svg class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <line x1="8" y1="6" x2="21" y2="6" stroke-linecap="round" stroke-linejoin="round" />
                <line x1="8" y1="12" x2="21" y2="12" stroke-linecap="round" stroke-linejoin="round" />
                <line x1="8" y1="18" x2="21" y2="18" stroke-linecap="round" stroke-linejoin="round" />
                <line x1="3" y1="6" x2="3.01" y2="6" stroke-linecap="round" stroke-linejoin="round" />
                <line x1="3" y1="12" x2="3.01" y2="12" stroke-linecap="round" stroke-linejoin="round" />
                <line x1="3" y1="18" x2="3.01" y2="18" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span>Daftar</span>
            </button>
          </div>

          <!-- Hidden summary element to avoid runtime JavaScript errors -->
          <div id="chapterSummary" class="hidden"></div>

          <!-- PANEL 1: FLASHCARD (KARTU BELAJAR) -->
          <section id="flashcardPanel" class="min-w-0 space-y-4">
            <!-- Progress Bar and Counter Row -->
            <div class="flex items-center justify-between gap-4 py-2 text-xs font-black text-slate-500">
              <div class="flex items-center gap-1 min-w-[50px]">
                <span id="progressIndex" class="text-slate-800">1</span>
                <span>/</span>
                <span id="progressTotal">40</span>
              </div>
              
              <div class="relative flex-1 h-1.5 bg-stone-200/80 rounded-full">
                <div id="progressBarFill" class="absolute left-0 top-0 h-full bg-stone-500 rounded-full transition-all duration-300" style="width: 2.5%"></div>
                <div id="progressBarDot" class="absolute -top-[3px] size-3 bg-stone-600 border border-white rounded-full shadow-sm transition-all duration-300" style="left: calc(2.5% - 6px)"></div>
              </div>

              <div class="flex items-center gap-1 text-slate-800 min-w-[60px] justify-end">
                <span id="hafalCount">0</span>
                <span class="text-slate-500 font-bold">hafal</span>
              </div>
            </div>

            <!-- The Study Card -->
            <button id="flashcard" class="relative isolate flex w-full min-w-0 flex-col justify-between overflow-hidden rounded-[1.75rem] border border-stone-200/80 bg-[#faf6ee] p-5 text-left shadow-lg transition-all active:scale-[0.99] sm:min-h-[380px] sm:p-6" type="button">
              <!-- Card background kanji graphic (watermark) -->
              <span class="pointer-events-none absolute bottom-4 left-5 z-0 select-none font-serif text-8xl font-bold leading-none text-stone-300/15">学</span>
              
              <!-- Card Header inside Card -->
              <div class="relative z-10 w-full text-left">
                <span id="cardMeta" class="text-xs font-black uppercase tracking-wider text-stone-500/80">BAB 1</span>
              </div>

              <!-- Card Main Body -->
              <div class="relative z-10 my-auto flex w-full min-w-0 flex-col items-center justify-center py-6">
                <!-- Japanese Prompt (Hiragana/Kanji) -->
                <div id="cardPrompt" class="max-w-full break-all text-center font-serif text-[clamp(3rem,14vw,6.5rem)] font-bold leading-tight tracking-normal text-slate-900"></div>
                
                <!-- Meaning and Answer part -->
                <div id="cardAnswer" class="w-full flex flex-col items-center mt-4">
                  <!-- Subtitle/Translation (Meaning) -->
                  <div id="cardMeaning" class="mt-1 max-w-full break-words text-center text-xl font-extrabold text-slate-800 sm:text-2xl"></div>
                  
                  <!-- Reading (if exists) -->
                  <div id="cardReading" class="mt-2 max-w-full break-all text-center text-sm font-black text-red-700/90"></div>
                  
                  <!-- Divider -->
                  <div class="w-full border-t border-dashed border-stone-300/60 my-5"></div>
                  
                  <!-- Example Sentence -->
                  <div id="cardExample" class="max-w-lg break-words text-center text-sm font-medium leading-relaxed text-stone-600"></div>
                </div>

                <!-- Card Hint when hidden -->
                <div id="cardHint" class="text-xs font-black uppercase tracking-wider text-stone-400 mt-6 bg-stone-100/80 px-3 py-1.5 rounded-full border border-stone-200/50">
                  Klik untuk lihat jawaban
                </div>
              </div>
            </button>

            <!-- "Belum hafal" and "Sudah hafal" Buttons Row -->
            <div class="grid grid-cols-2 gap-3">
              <button id="btnBelumHafal" class="flex items-center justify-center gap-2 rounded-2xl bg-[#ede8e0] hover:bg-[#e4dec2]/80 border border-stone-300/40 py-3.5 text-sm font-black text-stone-700 transition active:scale-95 flex-1 cursor-pointer" type="button">
                <svg class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3" />
                </svg>
                <span>Belum hafal</span>
              </button>

              <button id="btnSudahHafal" class="flex items-center justify-center gap-2 rounded-2xl bg-[#a64332] hover:bg-[#933b2b] text-white py-3.5 text-sm font-black transition shadow-md shadow-[#a64332]/10 active:scale-95 flex-1 cursor-pointer" type="button">
                <svg class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 3.75V16.5L12 14.25 7.5 16.5V3.75m9 0H18A2.25 2.25 0 0120.25 6v12A2.25 2.25 0 0118 20.25H6A2.25 2.25 0 013.75 18V6A2.25 2.25 0 016 3.75h1.5m9 0h-9" />
                </svg>
                <span>Sudah hafal</span>
              </button>
            </div>

            <!-- Navigation toolbar below -->
            <div class="grid grid-cols-3 items-center gap-2 py-2 text-sm font-bold text-stone-600">
              <button id="prevCard" class="flex items-center justify-start gap-1 rounded-2xl px-2 py-2 transition-all hover:bg-white/70 hover:text-slate-950 active:scale-95" type="button">
                <span>← Sebelumnya</span>
              </button>
              
              <button id="btnShuffle" class="flex items-center justify-center gap-2 rounded-2xl px-2 py-2 font-bold text-stone-600 transition-all hover:bg-white/70 hover:text-slate-950 active:scale-95" type="button">
                <svg class="size-4 shrink-0 text-orange-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 4l11.733 11.733M4 20L15.733 8.267M20 4h-5.5M20 4v5.5M20 20h-5.5M20 20v-5.5" />
                </svg>
                <span>Acak</span>
              </button>

              <button id="nextCard" class="flex items-center justify-end gap-1 rounded-2xl px-2 py-2 transition-all hover:bg-white/70 hover:text-slate-950 active:scale-95" type="button">
                <span>Berikutnya →</span>
              </button>
            </div>

            <!-- Progress automatic saving & footer -->
            <div class="mt-6 border-t border-stone-200/60 pt-4 text-center">
              <div class="text-[11px] font-medium text-stone-500">Progres disimpan otomatis di perangkat ini</div>
              <div class="mt-4 text-[11px] text-stone-400 font-medium">
                © 2026 <span class="font-bold text-stone-600">Yoki Jati Perkasa</span>
              </div>
              <div class="mt-1.5 flex items-center justify-center gap-3 text-[10px] text-stone-400 font-medium">
                <a href="https://yokijp.com" target="_blank" class="hover:text-stone-600 transition">Website</a>
                <span>·</span>
                <a href="https://instagram.com/yokijp_" target="_blank" class="hover:text-stone-600 transition">Instagram @yokijp_</a>
                <span>·</span>
                <a href="https://tiktok.com/@yokijp_" target="_blank" class="hover:text-stone-600 transition">TikTok @yokijp_</a>
              </div>
            </div>
          </section>

          <!-- PANEL 2: LIST (DAFTAR MATERI) -->
          <section id="listPanel" class="hidden min-w-0 rounded-[2rem] border border-stone-200 bg-white p-5 shadow-lg shadow-slate-900/5">
            <input id="searchInput" type="search" placeholder="Cari materi..." class="mb-4 w-full rounded-2xl border border-stone-200 px-4 py-3 text-sm font-bold outline-none focus:border-stone-400 focus:bg-stone-50/50 transition-all" />
            <div id="itemList" class="grid gap-3"></div>
          </section>

          <section id="unmemorizedPanel" class="hidden min-w-0 rounded-[2rem] border border-stone-200 bg-white p-5 shadow-lg shadow-slate-900/5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <p class="text-xs font-black uppercase tracking-wider text-red-600">Belum hafal</p>
                <h2 class="mt-1 text-xl font-black text-slate-950">Daftar latihan ulang</h2>
              </div>
              <span id="unmemorizedCount" class="rounded-full bg-slate-950 px-3 py-1.5 text-xs font-black text-white">0 item</span>
            </div>
            <div id="unmemorizedList" class="mt-4 grid gap-3"></div>
          </section>

          <!-- PANEL 3: QUIZ (KUIS CEPAT) -->
          <section id="quizPanel" class="hidden min-w-0 rounded-[2rem] border border-stone-200 bg-white p-5 shadow-lg shadow-slate-900/5">
            <div class="mb-4 flex items-center justify-between gap-3">
              <div id="quizMeta" class="text-xs font-black uppercase text-slate-500 tracking-wider">Kuis Cepat</div>
              <div id="quizScore" class="rounded-xl bg-slate-950 px-3 py-1.5 text-xs font-black text-white">0 benar</div>
            </div>
            <div class="mb-4 grid grid-cols-3 gap-2 text-center">
              <div class="rounded-2xl bg-[#faf6ee] px-3 py-3">
                <div class="text-[10px] font-black uppercase text-stone-500">Streak</div>
                <div id="quizStreak" class="mt-1 text-xl font-black text-slate-950">0</div>
              </div>
              <div class="rounded-2xl bg-[#faf6ee] px-3 py-3">
                <div class="text-[10px] font-black uppercase text-stone-500">Terbaik</div>
                <div id="quizBestStreak" class="mt-1 text-xl font-black text-slate-950">0</div>
              </div>
              <div class="rounded-2xl bg-[#faf6ee] px-3 py-3">
                <div class="text-[10px] font-black uppercase text-stone-500">Jawab</div>
                <div id="quizAnswered" class="mt-1 text-xl font-black text-slate-950">0</div>
              </div>
            </div>
            <div class="rounded-[1.5rem] bg-slate-950 p-6 text-center">
              <div id="quizPrompt" class="break-all font-serif text-5xl font-bold leading-tight text-white sm:text-6xl"></div>
            </div>
            <div id="quizFeedback" class="mt-4 hidden rounded-2xl px-4 py-3 text-sm font-black"></div>
            <div id="quizOptions" class="mt-4 grid gap-3 sm:grid-cols-2"></div>
            <button id="nextQuiz" class="mt-4 hidden w-full rounded-xl bg-red-600 px-4 py-3 text-sm font-black text-white hover:bg-red-700 transition active:scale-95 cursor-pointer">Soal Berikut</button>
          </section>

      </div>
    </section>

    <script define:vars={{ items, type, level }}>
      import { createFirebaseDb, firebaseDocId, isFirebaseConfigured } from "../../../lib/firebase";

      const allItems = items;
      let chapter = "all";
      let mode = "flashcard";
      let isShuffled = false;
      let deck = allItems.slice();
      let cardIndex = 0;
      let revealed = false;
      let currentQuiz = null;
      let quizAnsweredCurrent = false;

      // LocalStorage Key for progress tracking
      const activeSession = JSON.parse(localStorage.getItem("yokislearn:session") || "null");
      const storageOwner = activeSession?.nim || "guest";
      const storageKey = `yokislearn:memorized:${storageOwner}:${type}:${level}`;
      const quizStatsKey = `yokislearn:quiz:${storageOwner}:${type}:${level}`;
      let memorizedIds = new Set();
      let quizStats = {
        correct: 0,
        answered: 0,
        streak: 0,
        bestStreak: 0,
        lastStartedAt: "",
      };
      try {
        const stored = localStorage.getItem(storageKey);
        if (stored) {
          memorizedIds = new Set(JSON.parse(stored));
        }
      } catch (e) {
        console.error("Error loading progress", e);
      }

      function saveProgress() {
        try {
          localStorage.setItem(storageKey, JSON.stringify([...memorizedIds]));
        } catch (e) {
          console.error("Error saving progress", e);
        }
      }

      async function getFirebaseDb() {
        if (!isFirebaseConfigured || !activeSession?.nim) return null;
        try {
          return await createFirebaseDb();
        } catch {
          return null;
        }
      }

      async function loadRemoteProgress() {
        const db = await getFirebaseDb();
        if (!db) return;

        const { collection, getDocs, query, where } = await import("firebase/firestore");
        const snapshot = await getDocs(query(collection(db, "user_progress"), where("userNim", "==", storageOwner)));

        let changed = false;
        snapshot.docs.forEach((docSnapshot) => {
          const row = docSnapshot.data();
          if (row.materialType !== type || row.level !== level) return;
          if (row.status === "hafal") {
            memorizedIds.add(row.itemId);
            changed = true;
          }
          if (row.status === "belum") {
            memorizedIds.delete(row.itemId);
            changed = true;
          }
        });
        if (changed) saveProgress();
      }

      async function saveRemoteProgress(item, isMemorized) {
        const db = await getFirebaseDb();
        if (!db) return;

        const { doc, serverTimestamp, setDoc } = await import("firebase/firestore");
        await setDoc(doc(db, "user_progress", firebaseDocId(`${storageOwner}__${item.id}`)), {
          userNim: storageOwner,
          itemId: item.id,
          materialType: item.type,
          level: item.level,
          chapter: item.chapter,
          status: isMemorized ? "hafal" : "belum",
          updatedAt: serverTimestamp(),
        });
      }

      try {
        const storedQuizStats = localStorage.getItem(quizStatsKey);
        if (storedQuizStats) {
          quizStats = { ...quizStats, ...JSON.parse(storedQuizStats) };
        }
      } catch (e) {
        console.error("Error loading quiz stats", e);
      }

      function saveQuizStats() {
        try {
          localStorage.setItem(quizStatsKey, JSON.stringify(quizStats));
        } catch (e) {
          console.error("Error saving quiz stats", e);
        }
      }

      // UI Elements
      const modeButtons = [...document.querySelectorAll(".mode-btn")];
      const chapterTabs = [...document.querySelectorAll(".chapter-tab")];
      const panels = {
        flashcard: document.getElementById("flashcardPanel"),
        list: document.getElementById("listPanel"),
        quiz: document.getElementById("quizPanel"),
        unmemorized: document.getElementById("unmemorizedPanel"),
      };
      
      const cardMeta = document.getElementById("cardMeta");
      const cardPrompt = document.getElementById("cardPrompt");
      const cardHint = document.getElementById("cardHint");
      const cardAnswer = document.getElementById("cardAnswer");
      const cardReading = document.getElementById("cardReading");
      const cardMeaning = document.getElementById("cardMeaning");
      const cardExample = document.getElementById("cardExample");
      const itemList = document.getElementById("itemList");
      const searchInput = document.getElementById("searchInput");
      const quizMeta = document.getElementById("quizMeta");
      const quizPrompt = document.getElementById("quizPrompt");
      const quizOptions = document.getElementById("quizOptions");
      const quizScore = document.getElementById("quizScore");
      const quizStreak = document.getElementById("quizStreak");
      const quizBestStreak = document.getElementById("quizBestStreak");
      const quizAnswered = document.getElementById("quizAnswered");
      const quizFeedback = document.getElementById("quizFeedback");
      const nextQuiz = document.getElementById("nextQuiz");

      const progressIndex = document.getElementById("progressIndex");
      const progressTotal = document.getElementById("progressTotal");
      const progressBarFill = document.getElementById("progressBarFill");
      const progressBarDot = document.getElementById("progressBarDot");
      const hafalCount = document.getElementById("hafalCount");
      const btnBelumHafal = document.getElementById("btnBelumHafal");
      const btnSudahHafal = document.getElementById("btnSudahHafal");
      const btnShuffle = document.getElementById("btnShuffle");
      const unmemorizedList = document.getElementById("unmemorizedList");
      const unmemorizedCount = document.getElementById("unmemorizedCount");

      // Hidden summary element reference
      const chapterSummary = document.getElementById("chapterSummary") || { textContent: "" };

      function shuffle(values, avoidFirstId = "") {
        const shuffled = values.slice();
        for (let index = shuffled.length - 1; index > 0; index -= 1) {
          const swapIndex = Math.floor(Math.random() * (index + 1));
          [shuffled[index], shuffled[swapIndex]] = [shuffled[swapIndex], shuffled[index]];
        }

        if (avoidFirstId && shuffled.length > 1 && shuffled[0]?.id === avoidFirstId) {
          const swapIndex = shuffled.findIndex((item) => item.id !== avoidFirstId);
          [shuffled[0], shuffled[swapIndex]] = [shuffled[swapIndex], shuffled[0]];
        }

        return shuffled;
      }

      function syncDeck() {
        const filteredItems = chapter === "all" ? allItems.slice() : allItems.filter((item) => String(item.chapter) === chapter);
        
        if (isShuffled) {
          deck = shuffle(filteredItems);
        } else {
          deck = filteredItems;
        }

        cardIndex = Math.min(cardIndex, Math.max(deck.length - 1, 0));
        revealed = false;
        
        renderChapterTabs();
        updateHafalCount();
        renderActiveMode();
      }

      function renderChapterTabs() {
        chapterTabs.forEach((tab) => {
          const isActive = tab.dataset.chapter === chapter;
          if (isActive) {
            tab.className = "chapter-tab shrink-0 rounded-full px-5 py-2.5 text-sm font-black transition-all bg-slate-950 text-white shadow-sm cursor-pointer";
            tab.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
          } else {
            tab.className = "chapter-tab shrink-0 rounded-full px-5 py-2.5 text-sm font-black transition-all bg-white text-slate-700 hover:bg-slate-100 border border-black/5 cursor-pointer";
          }
        });
      }

      function updateHafalCount() {
        const currentDeckHafalCount = deck.filter((item) => memorizedIds.has(item.id)).length;
        if (hafalCount) hafalCount.textContent = currentDeckHafalCount;
      }

      function updateHafalButtonsState() {
        if (!deck.length) return;
        const currentItem = deck[cardIndex];
        const isMemorized = memorizedIds.has(currentItem.id);
        
        if (isMemorized) {
          if (btnSudahHafal) {
            btnSudahHafal.className = "flex items-center justify-center gap-2 rounded-2xl bg-[#a64332] text-white py-3.5 text-sm font-black transition shadow-md shadow-[#a64332]/20 active:scale-95 flex-1 cursor-pointer";
          }
          if (btnBelumHafal) {
            btnBelumHafal.className = "flex items-center justify-center gap-2 rounded-2xl bg-[#ede8e0]/60 hover:bg-[#ede8e0] border border-stone-300/20 py-3.5 text-sm font-black text-stone-400 transition active:scale-95 flex-1 cursor-pointer";
          }
        } else {
          if (btnSudahHafal) {
            btnSudahHafal.className = "flex items-center justify-center gap-2 rounded-2xl bg-[#a64332]/40 hover:bg-[#a64332]/60 text-white/90 py-3.5 text-sm font-black transition active:scale-95 flex-1 cursor-pointer";
          }
          if (btnBelumHafal) {
            btnBelumHafal.className = "flex items-center justify-center gap-2 rounded-2xl bg-[#ede8e0] hover:bg-[#e4dec2]/80 border border-stone-300/40 py-3.5 text-sm font-black text-stone-700 transition active:scale-95 flex-1 cursor-pointer";
          }
        }
      }

      function setMode(nextMode) {
        mode = nextMode;
        modeButtons.forEach((button) => {
          const active = button.dataset.mode === mode;
          if (active) {
            button.className = "mode-btn flex items-center justify-center gap-2 rounded-xl py-2.5 text-sm font-black transition-all bg-white text-slate-950 shadow-sm flex-1 cursor-pointer";
          } else {
            button.className = "mode-btn flex items-center justify-center gap-2 rounded-xl py-2.5 text-sm font-black transition-all text-stone-700 hover:bg-white/50 flex-1 cursor-pointer";
          }
        });
        Object.entries(panels).forEach(([key, panel]) => {
          if (panel) panel.classList.toggle("hidden", key !== mode);
        });
        renderActiveMode();
      }

      function renderActiveMode() {
        if (mode === "flashcard") renderCard();
        if (mode === "list") renderList();
        if (mode === "quiz") renderQuiz();
        if (mode === "unmemorized") renderUnmemorizedList();
      }

      function renderCard() {
        if (!deck.length) {
          if (cardPrompt) cardPrompt.textContent = "-";
          if (cardMeta) cardMeta.textContent = "Belum ada data";
          if (progressIndex) progressIndex.textContent = "0";
          if (progressTotal) progressTotal.textContent = "0";
          if (progressBarFill) progressBarFill.style.width = "0%";
          if (progressBarDot) progressBarDot.style.left = "calc(0% - 6px)";
          return;
        }
        const item = deck[cardIndex];
        if (cardMeta) cardMeta.textContent = type === "kanji" ? `Kanji ${level.toUpperCase()} - Grup ${item.chapter}` : `${item.type.toUpperCase()} Bab ${item.chapter}`;
        
        if (progressIndex) progressIndex.textContent = cardIndex + 1;
        if (progressTotal) progressTotal.textContent = deck.length;
        if (progressBarFill && progressBarDot) {
          const percentage = deck.length ? ((cardIndex + 1) / deck.length) * 100 : 0;
          progressBarFill.style.width = `${percentage}%`;
          progressBarDot.style.left = `calc(${percentage}% - 6px)`;
        }

        if (cardPrompt) cardPrompt.textContent = item.prompt;
        if (cardReading) cardReading.textContent = item.reading || "";
        if (cardMeaning) cardMeaning.textContent = item.meaning;
        
        let exampleText = item.example || "";
        if (!exampleText && item.note) {
          exampleText = item.note;
        }
        if (cardExample) cardExample.textContent = exampleText;

        if (cardAnswer) cardAnswer.classList.toggle("hidden", !revealed);
        if (cardHint) {
          cardHint.classList.toggle("hidden", revealed);
          cardHint.textContent = revealed ? "Klik untuk sembunyikan jawaban" : "Klik untuk lihat jawaban";
        }

        updateHafalButtonsState();
      }

      function renderList() {
        const query = searchInput ? searchInput.value.trim().toLowerCase() : "";
        const filtered = deck.filter((item) => {
          return !query || [item.prompt, item.reading, item.meaning, item.example, item.note].filter(Boolean).join(" ").toLowerCase().includes(query);
        });
        if (itemList) {
          itemList.innerHTML = filtered.map((item) => `
            <article class="rounded-2xl border border-stone-200 bg-[#faf6ee] p-5 shadow-sm">
              <div class="flex items-start justify-between gap-3">
                <div class="max-w-full break-all font-serif text-4xl font-bold leading-tight text-slate-950">${item.prompt}</div>
                <div class="rounded-md bg-stone-100 border border-stone-200/50 px-2 py-1 text-xs font-black text-slate-500">${type === "kanji" ? level.toUpperCase() : `Bab ${item.chapter}`}</div>
              </div>
              <div class="mt-3 break-all text-sm font-black text-red-700">${item.reading || ""}</div>
              <div class="mt-1 break-words text-base font-black text-slate-900">${item.meaning}</div>
              <div class="mt-2 break-words text-sm leading-6 text-slate-600">${item.example || item.note || ""}</div>
            </article>
          `).join("");
        }
      }

      function renderUnmemorizedList() {
        const filtered = deck.filter((item) => !memorizedIds.has(item.id));
        if (unmemorizedCount) unmemorizedCount.textContent = `${filtered.length} item`;
        if (!unmemorizedList) return;

        if (!filtered.length) {
          unmemorizedList.innerHTML = `<div class="rounded-2xl bg-[#faf6ee] p-5 text-sm font-bold text-stone-600">Semua item di pilihan ini sudah ditandai hafal.</div>`;
          return;
        }

        unmemorizedList.innerHTML = filtered.map((item) => `
          <article class="rounded-2xl border border-stone-200 bg-[#faf6ee] p-4 shadow-sm">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <div class="break-all font-serif text-3xl font-bold leading-tight text-slate-950">${item.prompt}</div>
                <div class="mt-2 break-words text-sm font-black text-red-700">${item.reading || ""}</div>
                <div class="mt-1 break-words text-sm font-black text-slate-800">${item.meaning}</div>
              </div>
              <button class="open-unmemorized shrink-0 rounded-2xl bg-slate-950 px-4 py-2 text-xs font-black text-white" data-id="${item.id}" type="button">Buka</button>
            </div>
          </article>
        `).join("");
      }

      function renderQuizStats() {
        if (quizScore) quizScore.textContent = `${quizStats.correct} benar`;
        if (quizStreak) quizStreak.textContent = quizStats.streak;
        if (quizBestStreak) quizBestStreak.textContent = quizStats.bestStreak;
        if (quizAnswered) quizAnswered.textContent = quizStats.answered;
      }

      function renderQuiz() {
        if (!deck.length) return;
        quizAnsweredCurrent = false;
        quizStats.lastStartedAt = new Date().toISOString();
        saveQuizStats();
        currentQuiz = shuffle(deck)[0];
        const options = shuffle([currentQuiz, ...shuffle(allItems.filter((item) => item.id !== currentQuiz.id)).slice(0, 3)]);
        if (quizMeta) quizMeta.textContent = type === "kanji" ? `Kanji ${level.toUpperCase()}` : `${currentQuiz.type.toUpperCase()} Bab ${currentQuiz.chapter}`;
        if (quizPrompt) quizPrompt.textContent = currentQuiz.prompt;
        renderQuizStats();
        if (quizFeedback) {
          quizFeedback.className = "mt-4 hidden rounded-2xl px-4 py-3 text-sm font-black";
          quizFeedback.textContent = "";
        }
        if (nextQuiz) nextQuiz.classList.add("hidden");
        if (quizOptions) {
          quizOptions.innerHTML = options.map((item) => `
            <button class="quiz-option rounded-xl border border-stone-200 bg-white px-4 py-4 text-left text-sm font-black text-slate-800 hover:border-slate-950 transition active:scale-[0.98] cursor-pointer w-full" data-id="${item.id}">
              <span class="block">${item.meaning}</span>
              <span class="quiz-result mt-2 hidden text-xs uppercase tracking-wider"></span>
            </button>
          `).join("");
        }
      }

      function answerQuiz(selectedButton) {
        if (!currentQuiz || quizAnsweredCurrent) return;
        quizAnsweredCurrent = true;
        const correct = selectedButton.dataset.id === currentQuiz.id;

        quizStats.answered += 1;
        if (correct) {
          quizStats.correct += 1;
          quizStats.streak += 1;
          quizStats.bestStreak = Math.max(quizStats.bestStreak, quizStats.streak);
        } else {
          quizStats.streak = 0;
        }
        saveQuizStats();
        renderQuizStats();

        [...quizOptions.querySelectorAll("button")].forEach((button) => {
          const isCorrectOption = button.dataset.id === currentQuiz.id;
          const result = button.querySelector(".quiz-result");
          button.disabled = true;
          button.classList.remove("hover:border-slate-950");

          if (isCorrectOption) {
            button.classList.add("border-emerald-600", "bg-emerald-50", "text-emerald-800", "ring-2", "ring-emerald-100");
            if (result) {
              result.textContent = "Benar";
              result.className = "quiz-result mt-2 block text-xs font-black uppercase tracking-wider text-emerald-700";
            }
            return;
          }

          if (button === selectedButton) {
            button.classList.add("border-red-700", "bg-red-50", "text-red-800", "ring-2", "ring-red-100");
            if (result) {
              result.textContent = "Salah";
              result.className = "quiz-result mt-2 block text-xs font-black uppercase tracking-wider text-red-700";
            }
          } else {
            button.classList.add("opacity-60");
          }
        });

        if (quizFeedback) {
          if (correct) {
            quizFeedback.textContent = `Benar. Streak kamu sekarang ${quizStats.streak}.`;
            quizFeedback.className = "mt-4 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-black text-emerald-800";
          } else {
            quizFeedback.textContent = `Salah. Jawaban yang benar: ${currentQuiz.meaning}.`;
            quizFeedback.className = "mt-4 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-black text-red-800";
          }
        }

        if (nextQuiz) nextQuiz.classList.remove("hidden");
      }

      function markMemorized(isMemorized) {
        if (!deck.length) return;
        const currentItem = deck[cardIndex];
        if (isMemorized) {
          memorizedIds.add(currentItem.id);
        } else {
          memorizedIds.delete(currentItem.id);
        }
        saveProgress();
        void saveRemoteProgress(currentItem, isMemorized);
        updateHafalCount();
        updateHafalButtonsState();
        if (mode === "unmemorized") renderUnmemorizedList();

        if (isMemorized && deck.length > 1) {
          setTimeout(() => {
            cardIndex = (cardIndex + 1) % deck.length;
            revealed = false;
            renderCard();
          }, 250);
        }
      }

      function toggleShuffle() {
        const currentId = deck[cardIndex]?.id || "";
        isShuffled = true;
        if (btnShuffle) {
          btnShuffle.className = "flex items-center justify-center gap-2 rounded-2xl border border-orange-200/50 bg-orange-50 px-2 py-2 font-extrabold text-orange-600 shadow-sm transition-all active:scale-95";
        }
        const filteredItems = chapter === "all" ? allItems.slice() : allItems.filter((item) => String(item.chapter) === chapter);
        deck = shuffle(filteredItems, currentId);
        cardIndex = 0;
        revealed = false;
        updateHafalCount();
        renderActiveMode();
      }

      // Add Event Listeners
      chapterTabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          chapter = tab.dataset.chapter;
          cardIndex = 0;
          syncDeck();
        });
      });

      modeButtons.forEach((button) => button.addEventListener("click", () => setMode(button.dataset.mode)));
      
      const flashcardEl = document.getElementById("flashcard");
      if (flashcardEl) {
        flashcardEl.addEventListener("click", () => {
          revealed = !revealed;
          renderCard();
        });
      }

      const prevCardBtn = document.getElementById("prevCard");
      if (prevCardBtn) {
        prevCardBtn.addEventListener("click", () => {
          if (deck.length) {
            cardIndex = (cardIndex - 1 + deck.length) % deck.length;
            revealed = false;
            renderCard();
          }
        });
      }

      const nextCardBtn = document.getElementById("nextCard");
      if (nextCardBtn) {
        nextCardBtn.addEventListener("click", () => {
          if (deck.length) {
            cardIndex = (cardIndex + 1) % deck.length;
            revealed = false;
            renderCard();
          }
        });
      }

      if (btnBelumHafal) {
        btnBelumHafal.addEventListener("click", () => markMemorized(false));
      }
      if (btnSudahHafal) {
        btnSudahHafal.addEventListener("click", () => markMemorized(true));
      }
      if (btnShuffle) {
        btnShuffle.addEventListener("click", toggleShuffle);
      }

      if (searchInput) searchInput.addEventListener("input", renderList);

      if (unmemorizedList) {
        unmemorizedList.addEventListener("click", (event) => {
          const button = event.target.closest(".open-unmemorized");
          if (!button) return;
          const targetIndex = deck.findIndex((item) => item.id === button.dataset.id);
          if (targetIndex < 0) return;
          cardIndex = targetIndex;
          revealed = true;
          setMode("flashcard");
          renderCard();
        });
      }
      
      if (quizOptions) {
        quizOptions.addEventListener("click", (event) => {
          const button = event.target.closest("button");
          if (!button || button.disabled) return;
          answerQuiz(button);
        });
      }
      
      if (nextQuiz) nextQuiz.addEventListener("click", renderQuiz);

      await loadRemoteProgress();
      syncDeck();
    </script>
  </AppShell>
</Layout>
