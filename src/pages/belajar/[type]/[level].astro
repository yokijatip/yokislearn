---
import Layout from "../../../layouts/Layout.astro";
import AppShell from "../../../components/AppShell.astro";
import { getChapters, getItems, levels, materialTypes, type Level, type MaterialType } from "../../../data/learning";

export function getStaticPaths() {
  return materialTypes.flatMap((type) =>
    levels.map((level) => ({
      params: { type: type.id, level: level.id },
    })),
  );
}

const { type, level } = Astro.params as { type: MaterialType; level: Level };
const material = materialTypes.find((item) => item.id === type)!;
const levelInfo = levels.find((item) => item.id === level)!;
const items = getItems(type, level);
const chapters = getChapters(type, level);
const activeName = material.label;
---

<Layout title={`${material.label} ${levelInfo.label} - YokisLearn`}>
  <AppShell active={activeName}>
    <section class="mx-auto w-full max-w-6xl overflow-x-clip px-3 py-5 sm:px-4 sm:py-8">
      <div class="grid min-w-0 gap-4 lg:grid-cols-[220px_minmax(0,1fr)]">
        <aside class="min-w-0 overflow-hidden h-fit rounded-[1.5rem] border border-black/5 bg-white/90 p-4 shadow-lg shadow-slate-900/5">
          <div class="flex items-center justify-between gap-3 lg:block">
            <div>
              <div class="text-xs font-black uppercase text-red-600">{levelInfo.label}</div>
              <h1 class="mt-1 text-2xl font-black text-slate-950">{material.label}</h1>
            </div>
            <div class="rounded-2xl bg-slate-950 px-3 py-2 text-sm font-black text-white lg:mt-4">{items.length}</div>
          </div>

          <div class="mt-4 grid grid-cols-2 gap-2">
            {levels.map((target) => (
              <a href={`/belajar/${type}/${target.id}`} class:list={[
                "rounded-xl px-3 py-2 text-center text-sm font-black",
                target.id === level ? "bg-slate-950 text-white" : "bg-slate-100 text-slate-700",
              ]}>
                {target.label}
              </a>
            ))}
          </div>

          <div class="mt-4 grid grid-cols-3 gap-2 lg:grid-cols-1">
            {materialTypes.map((target) => (
              <a href={`/belajar/${target.id}/${level}`} class:list={[
                "rounded-xl px-3 py-2 text-sm font-black",
                target.id === type ? "bg-red-600 text-white" : "bg-slate-100 text-slate-700 hover:bg-slate-200",
              ]}>
                {target.label}
              </a>
            ))}
          </div>

          <a href={`/latihan/cetak?type=${type}&level=${level}`} class="mt-4 block rounded-2xl bg-slate-950 px-3 py-3 text-center text-sm font-black text-white hover:bg-red-600">
            Cetak Ulangan
          </a>
        </aside>

        <div class="min-w-0 space-y-4">
          <div class="rounded-[1.5rem] border border-black/5 bg-white/90 p-3 shadow-lg shadow-slate-900/5 sm:p-4">
            <div class="grid min-w-0 gap-3 xl:grid-cols-[360px_minmax(0,1fr)]">
              <div class="grid w-full min-w-0 grid-cols-3 gap-2 text-center">
                <button class="mode-btn rounded-xl bg-slate-950 px-3 py-2 text-sm font-black text-white" data-mode="flashcard">Flashcard</button>
                <button class="mode-btn rounded-xl bg-slate-100 px-3 py-2 text-sm font-black text-slate-700" data-mode="list">Daftar</button>
                <button class="mode-btn rounded-xl bg-slate-100 px-3 py-2 text-sm font-black text-slate-700" data-mode="quiz">Kuis</button>
              </div>
              <div class="grid min-w-0 gap-2 sm:grid-cols-[44px_minmax(0,1fr)_44px]">
                <button id="prevChapter" class="grid size-11 place-items-center rounded-xl bg-slate-100 text-lg font-black text-slate-700" type="button" aria-label="Bab sebelumnya">‹</button>
                <label class="min-w-0">
                  <span class="sr-only">Pilih {type === "kanji" ? "grup" : "bab"}</span>
                  <select id="chapterSelect" class="h-11 w-full rounded-xl border-0 bg-slate-100 px-4 text-sm font-black text-slate-800 outline-none ring-0">
                    <option value="all">Semua {type === "kanji" ? "Grup" : "Bab"}</option>
                    {chapters.map((chapter) => (
                      <option value={chapter}>{type === "kanji" ? "Grup" : "Bab"} {chapter}</option>
                    ))}
                  </select>
                </label>
                <button id="nextChapter" class="grid size-11 place-items-center rounded-xl bg-slate-100 text-lg font-black text-slate-700" type="button" aria-label="Bab berikutnya">›</button>
              </div>
            </div>
            <div id="chapterSummary" class="mt-3 rounded-2xl bg-[#fffaf1] px-4 py-3 text-sm font-black text-slate-600"></div>
          </div>

          <section id="flashcardPanel" class="min-w-0 rounded-[1.5rem] border border-black/5 bg-white p-3 shadow-lg shadow-slate-900/5 sm:p-4">
            <div class="mb-4 flex items-center justify-between gap-3">
              <div>
                <div id="cardMeta" class="text-xs font-black uppercase text-slate-500">Flashcard</div>
                <div id="cardCount" class="text-sm font-bold text-slate-600"></div>
              </div>
              <div class="flex gap-2">
                <button id="prevCard" class="rounded-xl border border-slate-200 px-4 py-2 text-sm font-black">Prev</button>
                <button id="nextCard" class="rounded-xl border border-slate-200 px-4 py-2 text-sm font-black">Next</button>
              </div>
            </div>
            <button id="flashcard" class="relative grid min-h-[360px] w-full max-w-full overflow-hidden rounded-[1.5rem] bg-slate-950 p-5 text-center text-white sm:min-h-[440px] sm:p-6">
              <span class="absolute -right-10 -top-10 size-36 rounded-full bg-red-600/80"></span>
              <span class="absolute bottom-4 left-5 font-serif text-8xl font-bold leading-none text-white/5">学</span>
              <div>
                <div id="cardPrompt" class="max-w-full break-all font-serif text-6xl font-bold leading-tight text-white sm:text-8xl"></div>
                <div id="cardHint" class="mt-5 text-sm font-black uppercase text-red-300">Klik untuk lihat jawaban</div>
                <div id="cardAnswer" class="mt-5 hidden">
                  <div id="cardReading" class="break-all text-xl font-black text-red-300 sm:text-2xl"></div>
                  <div id="cardMeaning" class="mt-2 break-words text-xl font-black text-white sm:text-2xl"></div>
                  <div id="cardExample" class="mt-4 break-words text-sm leading-7 text-slate-300"></div>
                </div>
              </div>
            </button>
          </section>

          <section id="listPanel" class="hidden min-w-0 rounded-[1.5rem] border border-black/5 bg-white p-4 shadow-lg shadow-slate-900/5">
            <input id="searchInput" type="search" placeholder="Cari materi..." class="mb-4 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-bold outline-none focus:border-slate-950" />
            <div id="itemList" class="grid gap-2"></div>
          </section>

          <section id="quizPanel" class="hidden min-w-0 rounded-[1.5rem] border border-black/5 bg-white p-4 shadow-lg shadow-slate-900/5">
            <div class="mb-4 flex items-center justify-between gap-3">
              <div id="quizMeta" class="text-sm font-black uppercase text-slate-500">Kuis Cepat</div>
              <div id="quizScore" class="rounded-xl bg-slate-950 px-3 py-2 text-sm font-black text-white">0 benar</div>
            </div>
            <div class="rounded-[1.5rem] bg-slate-950 p-6 text-center">
              <div id="quizPrompt" class="break-all font-serif text-6xl font-bold leading-tight text-white sm:text-7xl"></div>
            </div>
            <div id="quizOptions" class="mt-4 grid gap-3 sm:grid-cols-2"></div>
            <button id="nextQuiz" class="mt-4 hidden rounded-xl bg-red-600 px-4 py-3 text-sm font-black text-white">Soal Berikut</button>
          </section>
        </div>
      </div>
    </section>

    <script define:vars={{ items, type, level }}>
      const allItems = items;
      let chapter = "all";
      let mode = "flashcard";
      let deck = allItems.slice();
      let cardIndex = 0;
      let revealed = false;
      let score = 0;
      let currentQuiz = null;

      const modeButtons = [...document.querySelectorAll(".mode-btn")];
      const chapterSelect = document.getElementById("chapterSelect");
      const prevChapter = document.getElementById("prevChapter");
      const nextChapter = document.getElementById("nextChapter");
      const chapterSummary = document.getElementById("chapterSummary");
      const panels = {
        flashcard: document.getElementById("flashcardPanel"),
        list: document.getElementById("listPanel"),
        quiz: document.getElementById("quizPanel"),
      };
      const cardMeta = document.getElementById("cardMeta");
      const cardCount = document.getElementById("cardCount");
      const cardPrompt = document.getElementById("cardPrompt");
      const cardHint = document.getElementById("cardHint");
      const cardAnswer = document.getElementById("cardAnswer");
      const cardReading = document.getElementById("cardReading");
      const cardMeaning = document.getElementById("cardMeaning");
      const cardExample = document.getElementById("cardExample");
      const itemList = document.getElementById("itemList");
      const searchInput = document.getElementById("searchInput");
      const quizMeta = document.getElementById("quizMeta");
      const quizPrompt = document.getElementById("quizPrompt");
      const quizOptions = document.getElementById("quizOptions");
      const quizScore = document.getElementById("quizScore");
      const nextQuiz = document.getElementById("nextQuiz");

      function shuffle(values) {
        return values.map((item) => ({ item, sort: Math.random() })).sort((a, b) => a.sort - b.sort).map(({ item }) => item);
      }

      function syncDeck() {
        deck = chapter === "all" ? allItems.slice() : allItems.filter((item) => String(item.chapter) === chapter);
        cardIndex = Math.min(cardIndex, Math.max(deck.length - 1, 0));
        revealed = false;
        renderChapterSummary();
        renderActiveMode();
      }

      function renderChapterSummary() {
        const label = type === "kanji" ? "grup" : "bab";
        const chapterText = chapter === "all" ? `Semua ${label}` : `${label.charAt(0).toUpperCase() + label.slice(1)} ${chapter}`;
        chapterSummary.textContent = `${chapterText} · ${deck.length} item`;
      }

      function stepChapter(direction) {
        const values = ["all", ...[...new Set(allItems.map((item) => String(item.chapter)))].sort((a, b) => Number(a) - Number(b))];
        const currentIndex = Math.max(values.indexOf(chapter), 0);
        const nextIndex = (currentIndex + direction + values.length) % values.length;
        chapter = values[nextIndex];
        chapterSelect.value = chapter;
        syncDeck();
      }

      function setMode(nextMode) {
        mode = nextMode;
        modeButtons.forEach((button) => {
          const active = button.dataset.mode === mode;
          button.className = active
            ? "mode-btn rounded-xl bg-slate-950 px-3 py-2 text-sm font-black text-white"
            : "mode-btn rounded-xl bg-slate-100 px-3 py-2 text-sm font-black text-slate-700";
        });
        Object.entries(panels).forEach(([key, panel]) => panel.classList.toggle("hidden", key !== mode));
        renderActiveMode();
      }

      function renderActiveMode() {
        if (mode === "flashcard") renderCard();
        if (mode === "list") renderList();
        if (mode === "quiz") renderQuiz();
      }

      function renderCard() {
        if (!deck.length) {
          cardPrompt.textContent = "-";
          cardMeta.textContent = "Belum ada data";
          return;
        }
        const item = deck[cardIndex];
        cardMeta.textContent = type === "kanji" ? `Kanji ${level.toUpperCase()}` : `${item.type} Bab ${item.chapter}`;
        cardCount.textContent = `${cardIndex + 1} / ${deck.length}`;
        cardPrompt.textContent = item.prompt;
        cardReading.textContent = item.reading || "";
        cardMeaning.textContent = item.meaning;
        cardExample.textContent = item.example || item.note || "";
        cardAnswer.classList.toggle("hidden", !revealed);
        cardHint.textContent = revealed ? "Klik untuk sembunyikan jawaban" : "Klik untuk lihat jawaban";
      }

      function renderList() {
        const query = searchInput.value.trim().toLowerCase();
        const filtered = deck.filter((item) => {
          return !query || [item.prompt, item.reading, item.meaning, item.example, item.note].filter(Boolean).join(" ").toLowerCase().includes(query);
        });
        itemList.innerHTML = filtered.map((item) => `
          <article class="rounded-2xl border border-black/5 bg-[#fffaf1] p-4">
            <div class="flex items-start justify-between gap-3">
              <div class="max-w-full break-all font-serif text-4xl font-bold leading-tight text-slate-950">${item.prompt}</div>
              <div class="rounded-md bg-white px-2 py-1 text-xs font-black text-slate-500">${type === "kanji" ? level.toUpperCase() : `Bab ${item.chapter}`}</div>
            </div>
            <div class="mt-3 break-all text-sm font-black text-red-700">${item.reading || ""}</div>
            <div class="mt-1 break-words text-base font-black text-slate-900">${item.meaning}</div>
            <div class="mt-2 break-words text-sm leading-6 text-slate-600">${item.example || item.note || ""}</div>
          </article>
        `).join("");
      }

      function renderQuiz() {
        if (!deck.length) return;
        currentQuiz = shuffle(deck)[0];
        const options = shuffle([currentQuiz, ...shuffle(allItems.filter((item) => item.id !== currentQuiz.id)).slice(0, 3)]);
        quizMeta.textContent = type === "kanji" ? `Kanji ${level.toUpperCase()}` : `${currentQuiz.type} Bab ${currentQuiz.chapter}`;
        quizPrompt.textContent = currentQuiz.prompt;
        quizScore.textContent = `${score} benar`;
        nextQuiz.classList.add("hidden");
        quizOptions.innerHTML = options.map((item) => `
          <button class="quiz-option rounded-xl border border-slate-200 bg-white px-4 py-4 text-left text-sm font-black text-slate-800 hover:border-slate-950" data-id="${item.id}">
            ${item.meaning}
          </button>
        `).join("");
      }

      chapterSelect.addEventListener("change", () => {
        chapter = chapterSelect.value;
        syncDeck();
      });
      prevChapter.addEventListener("click", () => stepChapter(-1));
      nextChapter.addEventListener("click", () => stepChapter(1));

      modeButtons.forEach((button) => button.addEventListener("click", () => setMode(button.dataset.mode)));
      document.getElementById("flashcard").addEventListener("click", () => {
        revealed = !revealed;
        renderCard();
      });
      document.getElementById("prevCard").addEventListener("click", () => {
        cardIndex = (cardIndex - 1 + deck.length) % deck.length;
        revealed = false;
        renderCard();
      });
      document.getElementById("nextCard").addEventListener("click", () => {
        cardIndex = (cardIndex + 1) % deck.length;
        revealed = false;
        renderCard();
      });
      searchInput.addEventListener("input", renderList);
      quizOptions.addEventListener("click", (event) => {
        const button = event.target.closest("button");
        if (!button || button.disabled) return;
        const correct = button.dataset.id === currentQuiz.id;
        [...quizOptions.querySelectorAll("button")].forEach((item) => {
          item.disabled = true;
          if (item.dataset.id === currentQuiz.id) item.classList.add("border-emerald-600", "bg-emerald-50", "text-emerald-800");
        });
        if (!correct) button.classList.add("border-red-700", "bg-red-50", "text-red-800");
        if (correct) score += 1;
        quizScore.textContent = `${score} benar`;
        nextQuiz.classList.remove("hidden");
      });
      nextQuiz.addEventListener("click", renderQuiz);

      syncDeck();
    </script>
  </AppShell>
</Layout>
