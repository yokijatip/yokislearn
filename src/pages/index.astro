---
import Layout from "../layouts/Layout.astro";
import AppShell from "../components/AppShell.astro";
import { getItems, levels, materialTypes } from "../data/learning";

const readyCount = getItems().filter((item) => item.status !== "draft").length;
const n5KanjiCount = getItems("kanji", "n5").length;
const n4KanjiCount = getItems("kanji", "n4").length;
const totalKanjiCount = n5KanjiCount + n4KanjiCount;
const kotobaN5Count = getItems("kotoba", "n5").length;
const kotobaN4Count = getItems("kotoba", "n4").length;
---

<Layout title="YokisLearn - Ruang Belajar JLPT">
  <AppShell>
    <section class="mx-auto max-w-6xl px-4 py-5 sm:py-8">
      <div class="grid gap-4 lg:grid-cols-[1.25fr_0.75fr]">
        <a href="/belajar/kanji/n5" class="group relative min-h-[300px] overflow-hidden rounded-[2rem] bg-slate-950 p-6 text-white shadow-xl shadow-slate-900/10 sm:min-h-[360px] sm:p-8">
          <div class="absolute -right-8 -top-8 size-36 rounded-full bg-[#d71920] opacity-90"></div>
          <div class="absolute bottom-5 right-6 font-serif text-[9rem] font-bold leading-none text-white/10 sm:text-[12rem]">語</div>
          <div class="relative flex h-full flex-col justify-between">
            <div>
              <div class="inline-flex rounded-full bg-white/10 px-3 py-1 text-xs font-black text-red-100">Lanjutkan</div>
              <h1 class="mt-5 text-5xl font-black leading-none tracking-normal sm:text-6xl">Kanji</h1>
            </div>
            <div class="mt-10 flex items-end justify-between gap-4">
              <div>
                <div class="text-sm font-bold text-slate-300">Materi</div>
                <div class="text-4xl font-black">{totalKanjiCount}</div>
              </div>
              <span class="rounded-2xl bg-white px-5 py-3 text-sm font-black text-slate-950 transition group-hover:bg-red-600 group-hover:text-white">Mulai</span>
            </div>
          </div>
        </a>

        <div class="grid grid-cols-2 gap-4 lg:grid-cols-1">
          <a href="/latihan/cetak?type=kanji&level=n5" class="rounded-[1.5rem] border border-black/5 bg-[#d71920] p-5 text-white shadow-lg shadow-red-900/10">
            <div class="text-sm font-black text-red-100">Ulangan</div>
            <div class="mt-8 text-3xl font-black">PDF</div>
          </a>
          <a href="/games" class="rounded-[1.5rem] border border-black/5 bg-white p-5 shadow-lg shadow-slate-900/5">
            <div class="text-sm font-black text-slate-500">Latihan</div>
            <div class="mt-8 text-3xl font-black text-slate-950">Games</div>
          </a>
          <div class="col-span-2 rounded-[1.5rem] border border-black/5 bg-white p-5 shadow-lg shadow-slate-900/5 lg:col-span-1">
            <div class="text-sm font-black text-slate-500">Database materi</div>
            <div class="mt-6 flex items-end justify-between">
              <div class="text-4xl font-black text-slate-950">{readyCount}</div>
              <div class="text-sm font-bold text-slate-500">item siap</div>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <a href="/belajar/kanji/n5" class="rounded-[1.5rem] border border-black/5 bg-white p-5 shadow-lg shadow-slate-900/5 transition hover:-translate-y-0.5 hover:shadow-xl">
          <div class="flex items-center justify-between">
            <div class="text-2xl font-black text-slate-950">Kanji</div>
            <div class="rounded-full bg-slate-100 px-3 py-1 text-xs font-black text-slate-600">{totalKanjiCount}</div>
          </div>
          <div class="mt-8 h-2 rounded-full bg-slate-100">
            <div class="h-2 w-4/5 rounded-full bg-slate-950"></div>
          </div>
        </a>
        <a href="/belajar/kotoba/n5" class="rounded-[1.5rem] border border-black/5 bg-[#fffaf1] p-5 shadow-lg shadow-slate-900/5 transition hover:-translate-y-0.5 hover:shadow-xl">
          <div class="flex items-center justify-between">
            <div class="text-2xl font-black text-slate-950">Kotoba</div>
            <div class="rounded-full bg-amber-100 px-3 py-1 text-xs font-black text-amber-700">{kotobaN5Count + kotobaN4Count}</div>
          </div>
          <div class="mt-8 h-2 rounded-full bg-amber-100">
            <div class="h-2 w-4/5 rounded-full bg-amber-500"></div>
          </div>
        </a>
      </div>

      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        {levels.map((level) => (
          <div class="rounded-[1.5rem] border border-black/5 bg-white/80 p-5 shadow-lg shadow-slate-900/5">
            <div class="flex items-center justify-between gap-3">
              <div class="text-2xl font-black text-slate-950">{level.label}</div>
              <div class="rounded-full bg-slate-100 px-3 py-1 text-xs font-black text-slate-500">{level.id === "n5" ? "aktif" : "kanji/kotoba"}</div>
            </div>
            <div class="mt-4 flex flex-wrap gap-2">
              {materialTypes.map((type) => (
                <a href={`/belajar/${type.id}/${level.id}`} class="rounded-full border border-black/5 bg-white px-4 py-2 text-sm font-black text-slate-700 shadow-sm hover:bg-slate-950 hover:text-white">
                  {type.label}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </AppShell>
</Layout>
