---
import Layout from "../../layouts/Layout.astro";
import { isSupabaseConfigured } from "../../lib/supabase";

export const prerender = false;

const accessPassword = "Yokijatiperkasa30!";
let unlocked = false;
let accessError = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  unlocked = formData.get("accessPassword") === accessPassword;
  accessError = unlocked ? "" : "Password akses salah.";
}
---

<Layout title="Register Murid - YokisLearn">
  <main class="min-h-screen overflow-x-hidden bg-[#f7f4ee] text-slate-950">
    <header class="mx-auto flex w-full max-w-5xl items-center justify-between gap-3 px-4 py-5 sm:px-6">
      <a href="/" class="min-w-0 flex items-center gap-3">
        <div class="grid size-12 place-items-center rounded-2xl bg-[#d71920] font-serif text-2xl font-bold text-white shadow-[0_10px_24px_rgba(215,25,32,0.22)]">
          学
        </div>
        <div class="min-w-0">
          <div class="text-xl font-black leading-tight text-slate-950">YokisLearn</div>
          <div class="text-xs font-bold text-slate-500">LPK Baraya</div>
        </div>
      </a>
      <a href="/akun" class="shrink-0 rounded-2xl border border-black/10 bg-white/70 px-4 py-2 text-sm font-black text-slate-700 transition hover:border-slate-950 hover:text-slate-950">
        Akun
      </a>
    </header>

    <section class="mx-auto w-full max-w-5xl px-4 py-6 sm:px-6 sm:py-10">
      {!unlocked ? (
        <section class="mx-auto max-w-xl rounded-[1.75rem] border border-black/5 bg-white p-5 shadow-xl shadow-slate-900/5 sm:p-7">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs font-black uppercase tracking-wider text-red-600">Register</p>
              <h1 class="mt-1 text-3xl font-black leading-tight text-slate-950">Password akses</h1>
            </div>
            <span class="rounded-full bg-stone-100 px-3 py-1.5 text-xs font-black text-stone-600">Terkunci</span>
          </div>

          <form method="post" class="mt-6 grid gap-3">
            <label class="grid gap-2 text-sm font-black text-slate-800">
              Password
              <input
                class="h-12 rounded-2xl border border-stone-200 bg-[#fffaf1] px-4 text-base font-black text-slate-950 outline-none transition focus:border-slate-950"
                name="accessPassword"
                type="password"
                autocomplete="current-password"
                required
              />
            </label>
            <button class="h-12 rounded-2xl bg-slate-950 px-4 text-sm font-black text-white transition active:scale-[0.98]" type="submit">
              Buka register
            </button>
            <p class="min-h-5 text-sm font-bold text-red-700">{accessError}</p>
          </form>
        </section>
      ) : (
        <div class="grid gap-4 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]">
          <section class="rounded-[1.75rem] border border-black/5 bg-white p-5 shadow-xl shadow-slate-900/5 sm:p-7">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-xs font-black uppercase tracking-wider text-red-600">Register</p>
                <h1 class="mt-1 text-3xl font-black leading-tight text-slate-950">Buat akun murid</h1>
              </div>
              <span id="storageStatus" class="rounded-full bg-stone-100 px-3 py-1.5 text-xs font-black text-stone-600">
                {isSupabaseConfigured ? "Supabase" : "Lokal"}
              </span>
            </div>

            <form id="registerForm" class="mt-6 grid gap-3">
              <label class="grid gap-2 text-sm font-black text-slate-800">
                NIM
                <input
                  id="studentNim"
                  class="h-12 rounded-2xl border border-stone-200 bg-[#fffaf1] px-4 text-base font-black text-slate-950 outline-none transition focus:border-slate-950"
                  name="nim"
                  autocomplete="username"
                  placeholder="Contoh: BARA001"
                  required
                />
              </label>
              <label class="grid gap-2 text-sm font-black text-slate-800">
                Nama
                <input
                  id="studentName"
                  class="h-12 rounded-2xl border border-stone-200 bg-[#fffaf1] px-4 text-base font-black text-slate-950 outline-none transition focus:border-slate-950"
                  name="name"
                  autocomplete="name"
                  placeholder="Nama murid"
                  required
                />
              </label>
              <button id="submitButton" class="h-12 rounded-2xl bg-red-600 px-4 text-sm font-black text-white transition active:scale-[0.98]" type="submit">
                Buat akun
              </button>
              <p id="registerMessage" class="min-h-5 text-sm font-bold text-slate-600"></p>
            </form>
          </section>

          <section class="rounded-[1.75rem] border border-black/5 bg-white p-5 shadow-xl shadow-slate-900/5 sm:p-7">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-xs font-black uppercase tracking-wider text-red-600">Murid</p>
                <h2 class="mt-1 text-2xl font-black leading-tight text-slate-950">Akun tersedia</h2>
              </div>
              <span id="studentCount" class="rounded-full bg-slate-950 px-3 py-1.5 text-xs font-black text-white">0 murid</span>
            </div>
            <div id="studentList" class="mt-5 grid gap-2"></div>
          </section>
        </div>
      )}
    </section>

    {unlocked && (
      <script>
        import { createStudentAccount, escapeHtml, getUsers, normalizeNim } from "../../lib/accounts";

        const registerForm = document.getElementById("registerForm");
        const studentNim = document.getElementById("studentNim");
        const studentName = document.getElementById("studentName");
        const registerMessage = document.getElementById("registerMessage");
        const submitButton = document.getElementById("submitButton");
        const studentList = document.getElementById("studentList");
        const studentCount = document.getElementById("studentCount");
        const storageStatus = document.getElementById("storageStatus");

        function setMessage(message, tone = "neutral") {
          if (!registerMessage) return;
          registerMessage.textContent = message;
          registerMessage.className = tone === "error"
            ? "min-h-5 text-sm font-bold text-red-700"
            : tone === "success"
              ? "min-h-5 text-sm font-bold text-emerald-700"
              : "min-h-5 text-sm font-bold text-slate-600";
        }

        async function renderStudents() {
          const { users, remoteError } = await getUsers();
          const students = users.filter((user) => user.role === "murid");

          if (studentCount) studentCount.textContent = `${students.length} murid`;
          if (storageStatus && remoteError) {
            storageStatus.textContent = "Lokal";
            storageStatus.className = "rounded-full bg-amber-50 px-3 py-1.5 text-xs font-black text-amber-700";
          }

          if (!studentList) return;
          if (!students.length) {
            studentList.innerHTML = `<div class="rounded-2xl bg-[#f7f4ee] px-4 py-4 text-sm font-bold text-stone-600">${remoteError ? "Supabase belum siap. Akun baru akan tersimpan di browser ini." : "Belum ada akun murid."}</div>`;
            return;
          }

          studentList.innerHTML = students.map((student) => `
            <article class="flex items-center justify-between gap-3 rounded-2xl border border-stone-200 bg-[#fffaf1] px-4 py-3">
              <div class="min-w-0">
                <div class="truncate text-sm font-black text-slate-950">${escapeHtml(student.name)}</div>
                <div class="text-xs font-bold text-stone-500">${escapeHtml(student.nim)}</div>
              </div>
              <span class="shrink-0 rounded-full bg-white px-3 py-1 text-xs font-black text-slate-700">murid</span>
            </article>
          `).join("");
        }

        registerForm?.addEventListener("submit", async (event) => {
          event.preventDefault();
          const nim = normalizeNim(studentNim?.value);
          const name = String(studentName?.value || "").trim();

          if (!nim || !name) {
            setMessage("NIM dan nama wajib diisi.", "error");
            return;
          }

          if (submitButton) {
            submitButton.setAttribute("disabled", "true");
            submitButton.textContent = "Menyimpan...";
          }

          const result = await createStudentAccount({ nim, name, createdBy: "REGISTER" });

          if (submitButton) {
            submitButton.removeAttribute("disabled");
            submitButton.textContent = "Buat akun";
          }

          if (result.error) {
            setMessage(result.error.message, "error");
            return;
          }

          if (studentNim) studentNim.value = "";
          if (studentName) studentName.value = "";

          setMessage(
            result.remoteSaved
              ? `Akun ${result.account.name} dibuat. Murid bisa login pakai NIM ${result.account.nim}.`
              : `Akun ${result.account.name} dibuat di browser ini. Supabase perlu tabel accounts agar bisa dipakai dari perangkat lain.`,
            result.remoteSaved ? "success" : "neutral",
          );
          await renderStudents();
        });

        void renderStudents();
      </script>
    )}
  </main>
</Layout>
