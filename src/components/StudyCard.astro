---
import type { LearningItem } from "../data/learning";

interface Props {
  item: LearningItem;
}

const { item } = Astro.props;
---

<article class="group rounded-lg border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md">
  <div class="flex items-start justify-between gap-3">
    <div class="text-xs font-black uppercase tracking-normal text-slate-500">Bab {item.chapter}</div>
    <span class:list={[
      "rounded-md px-2 py-1 text-xs font-bold",
      item.status === "draft" ? "bg-amber-100 text-amber-800" : "bg-emerald-100 text-emerald-800",
    ]}>
      {item.status === "draft" ? "Draft" : "Siap"}
    </span>
  </div>
  <div class="mt-5 min-h-24">
    <div class="font-serif text-6xl font-bold leading-none text-slate-950">{item.prompt}</div>
    {item.reading && <div class="mt-3 text-base font-bold text-red-700">{item.reading}</div>}
    <div class="mt-2 text-lg font-extrabold text-slate-900">{item.meaning}</div>
  </div>
  {item.example && <p class="mt-5 border-t border-dashed border-slate-200 pt-4 text-sm leading-6 text-slate-600">{item.example}</p>}
  {item.note && <p class="mt-3 text-sm leading-6 text-slate-500">{item.note}</p>}
</article>
